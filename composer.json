{
  "name": "zc-center/thinkphp-sdk",
  "description": "ZC Center SAPI SDK for ThinkPHP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.5",
    "topthink/framework": "^6.1 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "ZcCenter\\ThinkPHP\\": "src/"
    }
  },
  "extra": {
    "think": {
      "services": [
        "ZcCenter\\ThinkPHP\\Service"
      ]
    }
  }
}
